    "MD010": true,
    "MD011": true,
    "MD012": true,
    "MD023": true,
    "MD027": true,
    "MD028": true,
    "MD037": true,
    "MD038": true,
    "MD039": true,
    "MD042": true,
    "MD053": true,
    "MD055": true,
    "MD056": true
  },
